{
  "name": "cypress-demo",
  "version": "1.0.0",
  "description": "E2E test automation framework for contact management app with Cypress, Allure reporting, and CI/CD",
  "main": "index.js",
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test": "npm run cypress:run",
    "test:headed": "cypress run --headed",
    "test:chrome": "cypress run --browser chrome",
    "allure:generate": "[ -d allure-report/history ] && cp -R allure-report/history allure-results/ || true; allure generate allure-results -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:clean": "rm -rf allure-results allure-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "cypress",
    "e2e",
    "testing",
    "automation",
    "allure",
    "ci-cd",
    "page-object-model"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@shelex/cypress-allure-plugin": "^2.41.2",
    "allure-commandline": "^2.36.0",
    "cypress": "^15.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-cypress": "^5.2.0"
  }
}
